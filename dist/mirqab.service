[Unit]
Description=mirqab system monitor daemon
Documentation=https://github.com/t1nk333r/mirqab
Requires=mirqab.socket
After=mirqab.socket

[Service]
Type=notify
ExecStart=/usr/bin/mirqab daemon
Restart=on-failure
RestartSec=2

[Install]
# Started at login, not only on a first client: the minute writer keeps
# history whether or not anything is connected (architecture §6.3).
WantedBy=default.target
Also=mirqab.socket
