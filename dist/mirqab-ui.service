[Unit]
Description=mirqab window
Documentation=https://github.com/t1nk333r/mirqab
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# The Cairo renderer: 50 MiB resident against 73 MiB with GTK's default GPU
# renderer, both idle at 0 % CPU (plan 001 step 31, measured 2026-11-13).
Environment=GSK_RENDERER=cairo
ExecStart=/usr/bin/mirqab-ui --background
Restart=no
